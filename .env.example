# .env.example: the settings Quoto needs. It is safe to commit (no real secrets).
#
#   cp .env.example .env
#
# Then edit `.env` (git ignores it). Never put real passwords in THIS file.
# Make a password with:  openssl rand -base64 24

POSTGRES_USER=quoto
POSTGRES_PASSWORD=
POSTGRES_DB=quoto_dev

# Optional (these are the defaults):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# In production use require (or verify-full): the connection is encrypted.
# POSTGRES_SSLMODE=prefer

# The web API (cargo run). The key opens every call: make a long one with
#   openssl rand -base64 32
# There is no default key, and it must be at least 32 characters.
API_KEY=
# Optional (these are the defaults). The API only listens on this computer:
# API_HOST=127.0.0.1
# API_PORT=3000
